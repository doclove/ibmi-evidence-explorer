/* Synthetic edge cases. FIXTURE-CANARY-CL */
/* CALL PGM(COMMENTED) is a comment and yields no edge */
PGM
  DCL VAR(&PGMNAME) TYPE(*CHAR) LEN(10) VALUE('CALL PGM(INSTRING)')
  CALL PGM(&PGMNAME)
  CALL PGM(NOSUCHPGM)
  CALL PGM(DUPPGM)
  CALL PGM(*LIBL/CYCLEA)
  CALL PGM(OTHERLIB/CYCLEA)
  CALL PGM(BAD/NAME/X)
  CALL PGM(CYCLEA) +
       PARM('x')
  SNDPGMMSG MSG('CALL PGM(INMSG)')
ENDPGM
